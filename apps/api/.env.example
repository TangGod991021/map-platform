APP_NAME=Qianshan Manyou API
APP_ENV=dev

# 管理接口前缀 / 公开接口前缀
API_PREFIX=/prod-api
PUBLIC_PREFIX=/map-api/v1

# 开发默认 SQLite；生产改为 MySQL，例如：
# DATABASE_URL=mysql+asyncmy://user:pass@127.0.0.1:3306/map_platform?charset=utf8mb4
DATABASE_URL=sqlite+aiosqlite:///./data/map_platform.db

# 生产必须替换
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRE_MINUTES=720

# 管理端与地图 H5 来源
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://tianmap.mengyu.live,https://map-admin.mengyu.live

# 上传文件目录
UPLOAD_DIR=./data/uploads

# 发布快照输出目录（H5 的 data/ 目录）
MAP_PUBLISH_DIR=../map-web/data

# 可选：管理端地图选点使用的天地图浏览器端 Key
TIANDITU_TK=
